# cpu: CPU; amd: native Linux ROCm; amd-wsl: Windows Docker Desktop + AMD GPU.
# For Radeon 880M on Windows: amd-wsl, USE_FP16=true, INFERENCE_BATCH_SIZE=1.
INFERENCE_DEVICE=cpu
# Compose expands this reference; keep it synchronized with INFERENCE_DEVICE.
COMPOSE_PROFILES=${INFERENCE_DEVICE}

# Internal inference batches, independent of the number of texts in a request.
INFERENCE_BATCH_SIZE=8
USE_FP16=false

API_HOST=127.0.0.1
API_PORT=8000

# Used outside Compose. Inside Compose the service hostname is set automatically.
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_RESULTS_URL=redis://localhost:6379/1
TASK_QUEUE=embeddings

# Result retention, polling interval and Redis timeouts (seconds).
RESULT_TTL_SECONDS=86400
POLL_INTERVAL_SECONDS=0.25
REDIS_SOCKET_TIMEOUT_SECONDS=5
# Must exceed the longest inference. Recovery after SIGKILL may take this long.
VISIBILITY_TIMEOUT_SECONDS=3600

# Model and input limits.
MODEL_ID=BAAI/bge-m3
MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
MAX_TEXTS=1024
# Includes <s> and </s>. Longer texts are rejected, never truncated.
MAX_INPUT_TOKENS=8192

# AMD only. Match these groups to the Linux host.
# PyTorch/ROCm versions and indexes are pinned in pyproject.toml and uv.lock.
AMD_VIDEO_GID=44
AMD_RENDER_GID=109
